prefix=@PREFIX@
exec_prefix=${prefix}
libdir=@LIBDIR@
includedir=${prefix}/include

Name: libcyn
Description: Read-only Linux system information access library
Version: @VERSION@
Libs: -L${libdir} -lcyn
Cflags: -I${includedir}

libcyn.pc: libcyn.pc.in
	sed -e 's|@PREFIX@|$(PREFIX)|g' \
	    -e 's|@VERSION@|$(VERSION)|g' \
	    $< > $@